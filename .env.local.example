NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Site mode: "teaser" = locked sky-shader-only teaser; anything else (or unset) = full store.
NEXT_PUBLIC_SITE_MODE=store

# Order emails (Resend). The sending domain must be verified in Resend.
RESEND_API_KEY=re_...
# Where seller order alerts are sent. If unset, only the customer email sends.
SELLER_EMAIL=you@example.com
# Optional override of the from address (default: "Sky Vase <orders@skyva.se>")
ORDER_EMAIL_FROM=Sky Vase <orders@skyva.se>
